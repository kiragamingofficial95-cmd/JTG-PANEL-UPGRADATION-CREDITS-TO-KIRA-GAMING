{
  "name": "jtg-blueprint-registry",
  "version": "1.0.0",
  "description": "JTG Blueprint Extension Registry & Marketplace",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "vite build",
    "build:server": "tsx build-server.ts",
    "build:client": "vite build",
    "start": "node dist/server.js",
    "start:dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist node_modules/.cache"
  },
  "dependencies": {
    "express": "^4.22.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "uuid": "^14.0.2",
    "jsonwebtoken": "^9.0.3",
    "axios": "^1.18.0",
    "fs-extra": "^11.3.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.0",
    "lucide-react": "^0.546.0",
    "framer-motion": "^12.40.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "esbuild": "^0.25.0",
    "vite": "^6.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@tailwindcss/vite": "^4.1.14",
    "tailwindcss": "^4.1.14",
    "cross-env": "^7.0.3",
    "rimraf": "^6.0.1"
  }
}
